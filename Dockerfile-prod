# Используем официальный образ Python
FROM python:3.13-slim

# Устанавливаем зависимости
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем uv через pip
RUN pip install uv

# Создаем рабочую директорию
WORKDIR /app

# Копируем только pyproject.toml для установки зависимостей
COPY pyproject.toml .

# Устанавливаем зависимости
RUN uv sync

# Копируем весь код приложения
COPY . .

# Открываем порт 8150 для веб-интерфейса
EXPOSE 8150

# Запускаем веб-интерфейс
# В prod-окружении будет использоваться app_settings.json (монтируется через volume)
CMD ["uv", "run", "python", "web_ui.py"]