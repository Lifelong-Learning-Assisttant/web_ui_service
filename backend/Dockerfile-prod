# backend/Dockerfile-prod
# Используем официальный образ uv с Python 3.12
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Установка системных утилит (curl нужен для healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Оптимизация uv / окружения
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV PYTHONUNBUFFERED=1

# Виртуальное окружение
ENV VIRTUAL_ENV=/opt/venv

WORKDIR /app

# Копируем метаданные проекта
COPY pyproject.toml uv.lock ./

# Создаём venv и синхронизируем зависимости
RUN uv venv ${VIRTUAL_ENV} \
    && uv sync --locked --active

# Копируем код приложения
COPY . .

# Добавляем venv в PATH
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

EXPOSE 8151

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8151/health || exit 1

# Запуск через uv
CMD ["uv", "run", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8151", "--workers", "1"]